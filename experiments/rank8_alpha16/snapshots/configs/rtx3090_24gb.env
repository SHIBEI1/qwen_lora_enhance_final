# Conservative first-run profile for one RTX 3090 (24GB VRAM) and ~31GB RAM.
# Variables can be overridden in the shell before invoking a script.
: "${QDE_TRAIN_RESOLUTION:=512}"
: "${QDE_CONTROL_RESOLUTION:=512}"
: "${QDE_BATCH_SIZE:=1}"
: "${QDE_BLOCKS_TO_SWAP:=16}"
: "${QDE_LORA_DIM:=16}"
: "${QDE_LORA_ALPHA:=32}"
: "${QDE_LORA_DROPOUT:=0.05}"
: "${QDE_LEARNING_RATE:=5e-5}"
: "${QDE_EPOCHS:=6}"
: "${QDE_SAVE_EVERY_EPOCHS:=1}"
: "${QDE_SEED:=3407}"
: "${QDE_WORKERS:=2}"
: "${QDE_INFERENCE_STEPS:=25}"
: "${QDE_GUIDANCE_SCALE:=4.0}"
